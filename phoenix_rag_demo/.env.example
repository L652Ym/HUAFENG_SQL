# DeepSeek API 配置
# 从 https://platform.deepseek.com/ 获取API密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 模型配置
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=deepseek-chat  # DeepSeek暂无专用embedding模型,可用chat模型或使用OpenAI

# Phoenix 配置
PHOENIX_PORT=6006
PHOENIX_HOST=0.0.0.0
PHOENIX_PROJECT_NAME=rag-demo

# 可选: 使用Phoenix Cloud
# PHOENIX_CLIENT_HEADERS=api_key=your_phoenix_api_key
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com

# RAG 配置
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=3
TEMPERATURE=0.1
